{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "nextjs"
    },
    "backend": {
      "root": "backend/",
      "framework": "fastapi",
      "entrypoint": "api.index:app",
      "functions": {
        "api/index.py": {
          "maxDuration": 1800,
          "includeFiles": ".camoufox_cache/**",
          "excludeFiles": "{tests/**,**/test_*.py,.pytest_cache/**,.ruff_cache/**}"
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
# --- Scraping / HTTP-first ---
HTTP_TIMEOUT=15
HTTP_MAX_RETRIES=2
HTTP_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36
CAMOUFOX_HEADLESS=true
CAMOUFOX_HUMANIZE=false

MAX_CONCURRENT_JOBS=1
MAX_CONCURRENT_PAGES=2

PAGE_TIMEOUT=30000
NAVIGATION_TIMEOUT=30000
MAX_RETRIES=2
REQUEST_DELAY_MS=800
MAX_COMPANIES_PER_CITY_CATEGORY=0

# --- Auth (Vercel Environment Variables) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
AUTH_SECRET=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Backward-compatible aliases (optional)
DEFAULT_USER_EMAIL=admin@example.com
DEFAULT_USER_PASSWORD=change-me

ALLOWED_ORIGINS=*

EXPORT_DIR=/tmp/exports

# --- Supabase (persistence: cross-job dedup + history) ---
# Optional. If empty, app runs in-memory only (no persistence).
SUPABASE_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres